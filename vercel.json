{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://baan-saat-backend-phi.vercel.app/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://baan-saat-backend-phi.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
